# Copy to .env (git-ignored) and fill in the values. Never commit a real value.
# Every name below is read by the code. Blank values are placeholders.

# --- Model provider (OpenRouter) ---
# Paid calls happen only when MILO_LIVE=1 is also set in the command's environment.
OPENROUTER_API_KEY=
MILO_LIVE=
# Primary chat model and its price in USD per million tokens (input, output).
MILO_CHAT_MODEL=anthropic/claude-haiku-5.5
MILO_PRICE_IN=0.10
MILO_PRICE_OUT=0.50

# --- Local fallback model (Ollama, no key, no spend) ---
MILO_LOCAL_MODEL=qwen3:8b

# --- Storage ---
# memory (default: lost on restart) or postgres (Supabase PostgreSQL, schema milo_v2).
MILO_STORE=memory
# Full PostgreSQL connection string. Needed when MILO_STORE=postgres and for scripts/migrate.py.
MILO_DATABASE_URL=

# --- Web app ---
# Signs the browser session cookie. Set a long random value; if it changes, sessions end.
MILO_SECRET_KEY=

# --- Tests and evaluation only (leave empty normally) ---
# Run the database tests against MILO_DATABASE_URL.
MILO_DB_TESTS=
# Allow a second read of the test split. Must stay empty; a second read is a new decision.
MILO_TEST_REREAD=
