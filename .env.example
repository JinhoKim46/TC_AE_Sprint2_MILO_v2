# MILO environment. Copy to .env and fill in the values. Never commit .env.
# `make up` reads this file. Lines marked "optional" can stay empty or be removed.

# --- Required for live answers and storage -------------------------------------------------
# Key for the chat model and the embeddings on OpenRouter.
OPENROUTER_API_KEY=
# PostgreSQL connection string (Supabase session pooler is fine). Used when MILO_STORE=postgres.
MILO_DATABASE_URL=
# Signs the session cookie. Any long random string; keep it secret.
MILO_SECRET_KEY=

# --- Set by `make up` (you can also set them here) -----------------------------------------
# 1 enables paid model calls. Without it nothing spends.
MILO_LIVE=1
# memory (default) or postgres.
MILO_STORE=postgres

# --- Optional ---------------------------------------------------------------------------------
# Chat model on OpenRouter (default: anthropic/claude-haiku-5.5).
# MILO_CHAT_MODEL=
# Prices in USD per million tokens, used for the cost line (defaults are set in code).
# MILO_PRICE_IN=
# MILO_PRICE_OUT=
# Local fallback model served by Ollama, used when the provider fails (default: qwen3:8b).
# MILO_LOCAL_MODEL=
# Chat engine: agent (create_agent, default when live) or loop (the app's own loop).
MILO_ENGINE=agent
# Bearer tokens for the MCP server: a JSON object of token to owner id. Only for `milo.mcp_server`.
# MILO_MCP_TOKENS=
# Password for the throwaway demo account, only for scripts/demo_server.py.
# MILO_DEMO_PASSWORD=
# Judge model for the (not usable) LLM judge experiment, default anthropic/claude-haiku-5.5.
# JUDGE_MODEL=

# --- Test guards (leave commented out) ----------------------------------------------------------------
# Set to 1 to allow a second read of the test or held-out split. Each read is logged.
# MILO_TEST_REREAD=
# MILO_HELDOUT_REREAD=
# Set to 1 to run the database tests against MILO_DATABASE_URL.
# MILO_DB_TESTS=
